#!/usr/bin/env bash
# =============================================================================
#  boot-splash —— 在「图形开机动画」与「内核日志文本启动」之间切换
#  Toggle between a graphical boot splash and plain kernel-log boot output.
#
#  目标观感：原版 Arch / Debian —— 内核 printk 日志 + systemd 的 [ OK ] 行
#
#  用法 / Usage:
#    boot-splash off [-y] [--dry-run]   关闭开机动画 / turn the splash off
#    boot-splash on  [-y] [--dry-run]   恢复开机动画 / restore the splash
#    boot-splash status [--porcelain]   查看状态 / show state
#    boot-splash rollback              回滚备份 / roll back
#
#  语言 / Language:
#    BOOT_SPLASH_LANG=zh|en   默认按系统 locale 自动判断。
#
#  设计要点 / Design notes:
#   1. 幂等 —— 目标值每次都从当前值重新推导，不做追加。
#   2. 状态化 —— 被剥离的参数会记录在 state 里，恢复时按记录加回。
#   3. 可重定向 —— BOOT_SPLASH_ROOT 把全部路径重定向到影子根。
#   4. 可回滚 —— 每次写入前备份，rollback 一条命令还原。
#
#  需要 bash 4.0+（关联数组 / associative arrays）。
# =============================================================================

set -euo pipefail

VERSION="V1.0"
PROG="${0##*/}"

# ---------- 可调配置 ---------------------------------------------------------
# 关闭动画后追加到内核命令行的参数
DEFAULT_CONSOLE_PARAMS="${BOOT_SPLASH_CONSOLE_PARAMS:-console=tty0 loglevel=7 fbcon=nodefer logo.nologo vt.global_cursor_default=0 plymouth.enable=0}"
# 这些参数既压内核日志也压 systemd 状态行，开动画时加回
DEFAULT_SPLASH_PARAMS="${BOOT_SPLASH_SPLASH_PARAMS:-quiet splash}"
# 只参与「剥离」、但不会作为默认恢复值的参数（Fedora/RHEL 的 rhgb）
DEFAULT_STRIP_EXTRA="${BOOT_SPLASH_STRIP_EXTRA:-rhgb}"
# 前缀形式的图形启动标志（openSUSE 的 splash=silent / splash=verbose）
DEFAULT_STRIP_PREFIXES="${BOOT_SPLASH_STRIP_PREFIXES:-splash=}"

BACKUP_KEEP=5

# ---------- 路径（全部经过影子根前缀）---------------------------------------
R="${BOOT_SPLASH_ROOT:-}"
STATE_DIR="${R}/var/lib/boot-splash"
BACKUP_DIR="${STATE_DIR}/backups"
STATE_FILE="${STATE_DIR}/state"

# 运行时全局
BACKEND=""        # kernel | limine | grub | bls
CMDLINE_KIND=""   # plain  | limine | grub
CMDLINE_FILE=""   # 实际读写的文件
DRY_RUN=no
ASSUME_YES=no
NO_REGEN=no
FORCE=no
PORCELAIN=no
CONSOLE_PARAMS="$DEFAULT_CONSOLE_PARAMS"
SPLASH_PARAMS="$DEFAULT_SPLASH_PARAMS"
STRIP_PARAMS=""
STRIP_PREFIXES=""
BLS_MODE="${BOOT_SPLASH_BLS:-auto}"   # auto | off

PEND_FILES=()
PEND_TMPS=()

# ---------- 输出 -------------------------------------------------------------
if [ -t 1 ]; then
  C_RED=$'\033[1;31m'; C_GRN=$'\033[1;32m'; C_YEL=$'\033[1;33m'
  C_BLU=$'\033[1;34m'; C_DIM=$'\033[2m'; C_OFF=$'\033[0m'
else
  C_RED=""; C_GRN=""; C_YEL=""; C_BLU=""; C_DIM=""; C_OFF=""
fi

# =============================================================================
#  国际化 / Internationalization
# =============================================================================

LANG_CODE="${BOOT_SPLASH_LANG:-}"
case "$LANG_CODE" in
  zh|en) ;;
  *) case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in
       zh*|*_CN*|*_TW*|*_HK*) LANG_CODE=zh ;;
       *)                     LANG_CODE=en ;;
     esac ;;
esac

